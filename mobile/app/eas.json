{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8094/api",
        "EXPO_PUBLIC_SITE_URL": "http://localhost:3000",
        "EXPO_PUBLIC_APP_NAME": "GoldMoodAstro",
        "EXPO_PUBLIC_PUBLIC_URL": "http://localhost:3000",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "destek@goldmoodastro.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://goldmoodastro.com/api",
        "EXPO_PUBLIC_SITE_URL": "https://goldmoodastro.com",
        "EXPO_PUBLIC_APP_NAME": "GoldMoodAstro",
        "EXPO_PUBLIC_PUBLIC_URL": "https://goldmoodastro.com",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "destek@goldmoodastro.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_IAP_PRODUCT_MONTHLY_IOS": "com.goldmoodastro.app.monthly",
        "EXPO_PUBLIC_IAP_PRODUCT_YEARLY_IOS": "com.goldmoodastro.app.yearly",
        "EXPO_PUBLIC_IAP_PRODUCT_MONTHLY_ANDROID": "com.goldmoodastro.app.monthly",
        "EXPO_PUBLIC_IAP_PRODUCT_YEARLY_ANDROID": "com.goldmoodastro.app.yearly",
        "EXPO_PUBLIC_IAP_CREDIT_STARTER_IOS": "com.goldmoodastro.app.credits.starter",
        "EXPO_PUBLIC_IAP_CREDIT_POPULAR_IOS": "com.goldmoodastro.app.credits.popular",
        "EXPO_PUBLIC_IAP_CREDIT_VALUE_IOS": "com.goldmoodastro.app.credits.value",
        "EXPO_PUBLIC_IAP_CREDIT_STARTER_ANDROID": "com.goldmoodastro.app.credits.starter",
        "EXPO_PUBLIC_IAP_CREDIT_POPULAR_ANDROID": "com.goldmoodastro.app.credits.popular",
        "EXPO_PUBLIC_IAP_CREDIT_VALUE_ANDROID": "com.goldmoodastro.app.credits.value",
        "EXPO_PUBLIC_API_URL": "https://goldmoodastro.com/api",
        "EXPO_PUBLIC_SITE_URL": "https://goldmoodastro.com",
        "EXPO_PUBLIC_APP_NAME": "GoldMoodAstro",
        "EXPO_PUBLIC_PUBLIC_URL": "https://goldmoodastro.com",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "destek@goldmoodastro.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.goldmoodastro.app",
        "appName": "GoldMoodAstro",
        "sku": "goldmoodastro-ios",
        "language": "tr-TR"
      },
      "android": {
        "applicationId": "com.goldmoodastro.app",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
